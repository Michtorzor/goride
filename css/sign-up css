```css
/* ==========================================
   GORIDE SIGN UP PAGE
   ========================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


:root {

    --navy: #062f47;
    --navy-dark: #092d49;

    --green: #00b978;
    --green-light: #00d98b;

    --white: #ffffff;

    --text: #183243;
    --muted: #71808d;

    --border: #dfe7eb;

}


/* ==========================================
   BODY
   ========================================== */

body {

    font-family: "Poppins", sans-serif;

    min-height: 100vh;

}


/* ==========================================
   SIGN UP PAGE
   ========================================== */

.signup-page {

    min-height: 100vh;

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 30px 15px;

    position: relative;

    overflow-y: auto;

}


/* ==========================================
   BACKGROUND
   ========================================== */

.signup-background {

    position: fixed;

    inset: 0;

    background:
        linear-gradient(
            rgba(6, 47, 71, 0.88),
            rgba(6, 47, 71, 0.94)
        ),
        url("../assets/background.jpeg");

    background-size: cover;

    background-position: center;

    z-index: -2;

}


.signup-overlay {

    position: fixed;

    inset: 0;

    background:
        radial-gradient(
            circle at top right,
            rgba(0, 217, 139, 0.16),
            transparent 35%
        );

    z-index: -1;

}


/* ==========================================
   CONTAINER
   ========================================== */

.signup-container {

    width: 100%;

    max-width: 600px;

}


/* ==========================================
   LOGO
   ========================================== */

.goride-logo {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 11px;

    color: white;

    margin-bottom: 22px;

}


.logo-icon {

    width: 48px;

    height: 48px;

    display: flex;

    align-items: center;

    justify-content: center;

    background: var(--green);

    border-radius: 13px;

    font-size: 22px;

    box-shadow:
        0 8px 25px rgba(0, 185, 120, 0.3);

}


.goride-logo h1 {

    font-size: 28px;

    font-weight: 800;

    line-height: 1;

}


.goride-logo h1 span {

    color: var(--green-light);

}


.goride-logo p {

    font-size: 10px;

    opacity: 0.8;

    margin-top: 4px;

}


/* ==========================================
   SIGN UP CARD
   ========================================== */

.signup-card {

    background: rgba(255, 255, 255, 0.98);

    border-radius: 22px;

    padding: 35px;

    position: relative;

    box-shadow:
        0 25px 70px rgba(0, 0, 0, 0.28);

    animation: slideUp 0.4s ease;

}


@keyframes slideUp {

    from {

        opacity: 0;

        transform: translateY(20px);

    }

    to {

        opacity: 1;

        transform: translateY(0);

    }

}


/* ==========================================
   CLOSE
   ========================================== */

.close-btn {

    position: absolute;

    top: 17px;

    right: 17px;

    width: 36px;

    height: 36px;

    border: none;

    border-radius: 50%;

    background: #f1f4f6;

    color: #637580;

    cursor: pointer;

    font-size: 16px;

    transition: 0.25s;

}


.close-btn:hover {

    background: var(--green);

    color: white;

    transform: rotate(90deg);

}


/* ==========================================
   HEADING
   ========================================== */

.signup-heading {

    text-align: center;

    margin-bottom: 28px;

}


.heading-icon {

    width: 58px;

    height: 58px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin: 0 auto 13px;

    border-radius: 17px;

    background: rgba(0, 185, 120, 0.10);

    color: var(--green);

    font-size: 23px;

}


.signup-heading h2 {

    color: var(--navy-dark);

    font-size: 24px;

    margin-bottom: 5px;

}


.signup-heading p {

    color: var(--muted);

    font-size: 12px;

    line-height: 1.6;

}


/* ==========================================
   FORM ROW
   ========================================== */

.form-row {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 15px;

}


/* ==========================================
   INPUT GROUP
   ========================================== */

.input-group {

    margin-bottom: 18px;

}


.input-group label {

    display: block;

    color: var(--navy-dark);

    font-size: 12px;

    font-weight: 600;

    margin-bottom: 7px;

}


/* ==========================================
   INPUT
   ========================================== */

.input-box {

    width: 100%;

    height: 50px;

    position: relative;

    display: flex;

    align-items: center;

}


.input-box > i {

    position: absolute;

    left: 15px;

    color: #8797a2;

    font-size: 14px;

    pointer-events: none;

}


.input-box input {

    width: 100%;

    height: 100%;

    border: 1px solid var(--border);

    border-radius: 11px;

    background: #fbfcfd;

    outline: none;

    padding: 0 43px;

    color: var(--text);

    font-family: inherit;

    font-size: 13px;

    transition: 0.25s;

}


.input-box input::placeholder {

    color: #a5b1b9;

}


.input-box input:focus {

    border-color: var(--green);

    background: white;

    box-shadow:
        0 0 0 3px rgba(0, 185, 120, 0.08);

}


.input-box:focus-within > i {

    color: var(--green);

}


/* ==========================================
   PASSWORD TOGGLE
   ========================================== */

.password-toggle {

    position: absolute;

    right: 9px;

    width: 32px;

    height: 32px;

    border: none;

    background: transparent;

    color: #84949f;

    cursor: pointer;

}


.password-toggle:hover {

    color: var(--green);

}


/* ==========================================
   TERMS
   ========================================== */

.terms {

    display: flex;

    align-items: flex-start;

    gap: 8px;

    margin: 5px 0 20px;

    color: var(--muted);

    font-size: 11px;

    line-height: 1.6;

    cursor: pointer;

}


.terms input {

    margin-top: 4px;

    accent-color: var(--green);

}


.terms a {

    color: var(--green);

    text-decoration: none;

    font-weight: 600;

}


.terms a:hover {

    text-decoration: underline;

}


/* ==========================================
   SIGN UP BUTTON
   ========================================== */

.signup-btn {

    width: 100%;

    height: 52px;

    border: none;

    border-radius: 11px;

    background:
        linear-gradient(
            135deg,
            var(--green),
            var(--green-light)
        );

    color: white;

    font-family: inherit;

    font-size: 13px;

    font-weight: 700;

    cursor: pointer;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    box-shadow:
        0 8px 20px rgba(0, 185, 120, 0.2);

    transition: 0.25s;

}


.signup-btn:hover {

    transform: translateY(-2px);

    box-shadow:
        0 12px 28px rgba(0, 185, 120, 0.28);

}


/* ==========================================
   LOGIN LINK
   ========================================== */

.login-link {

    text-align: center;

    margin-top: 22px;

    padding-top: 18px;

    border-top: 1px solid #edf1f3;

}


.login-link p {

    color: var(--muted);

    font-size: 12px;

}


.login-link a {

    color: var(--green);

    font-weight: 700;

    text-decoration: none;

}


.login-link a:hover {

    text-decoration: underline;

}


/* ==========================================
   REGISTER LINK
   ========================================== */

.register-link {

    text-align: center;

    margin-top: 14px;

}


.register-link p {

    color: var(--muted);

    font-size: 11px;

}


.register-link a {

    color: var(--navy);

    font-weight: 700;

    text-decoration: none;

}


.register-link a:hover {

    color: var(--green);

}

/* ================================
   BACK TO HOME BUTTON
================================ */

.back-home {
    position: fixed;
    top: 25px;
    left: 25px;
    z-index: 99999;

    display: inline-block;

    padding: 10px 18px;

    background: #00b978;
    color: white;

    text-decoration: none;

    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 600;

    border-radius: 8px;

    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);

    transition: all 0.3s ease;
}

.back-home:hover {
    background: #00d98b;
    transform: translateY(-2px);
}


/* ==========================================
   MOBILE
   ========================================== */

@media (max-width: 600px) {

    .signup-page {

        padding: 20px 12px;

        align-items: flex-start;

    }


    .signup-container {

        margin-top: 10px;

    }


    .signup-card {

        padding: 28px 20px;

        border-radius: 18px;

    }


    .goride-logo h1 {

        font-size: 25px;

    }


    .logo-icon {

        width: 43px;

        height: 43px;

        font-size: 20px;

    }


    .signup-heading h2 {

        font-size: 21px;

    }


    .form-row {

        grid-template-columns: 1fr;

        gap: 0;

    }

}


@media (max-width: 360px) {

    .signup-card {

        padding: 25px 16px;

    }

}
```
